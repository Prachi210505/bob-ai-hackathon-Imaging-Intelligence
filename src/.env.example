# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# Local SQLite database. The parent directory is ignored by Git.
DATABASE_PATH=data/trialguard.db

# Application
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development

# Set true only when you explicitly want the bundled development fixture.
SEED_DEMO_DATA=false

# Optional IBM Bob integration. Leave blank while developing locally.
BOB_API_URL=
BOB_API_KEY=
